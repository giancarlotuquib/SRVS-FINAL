@page "/Account/Login"

@using Microsoft.AspNetCore.Components
@using SRVS.Domain.Enums

@inject NavigationManager NavigationManager

<div class="container auth-page auth-page--login">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="auth-brand text-center">
                <div class="usjr-seal usjr-seal--hero">
                    <div class="usjr-seal__ring">
                        <img src="images/cpe_logo.png?v=202606231815" class="usjr-seal__img" alt="Computer Engineering Department logo" />
                    </div>
                </div>
                <h1 class="display-6 mb-1">Syllabus Repository</h1>
                <p class="text-uppercase small mb-0">College of Engineering</p>
            </div>

            <div class="card auth-card p-2">
                <div class="card-body">
                    <h3 class="auth-card__title text-center fw-bold" style="color:#0a4025;">Welcome!</h3>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <div>@ErrorMessage</div>
                        </div>
                    }

                    <form method="post" action="/Account/Login">

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" for="SchoolId">School ID</label>
                            <input type="text" name="SchoolId" id="SchoolId" class="form-control form-control-lg" placeholder="Enter your ID or Email" autocomplete="username" value="@(loginModel.SchoolId ?? string.Empty)" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-flex justify-content-between text-secondary fw-semibold" for="Password">
                                <span>Password</span>
                                <a class="small text-decoration-none text-success" href="/Account/ForgotPassword">Forgot password?</a>
                            </label>
                            <div class="input-group password-input-group">
                                <input type="password" name="Password" id="Password" class="form-control form-control-lg" autocomplete="current-password" placeholder="••••••••" value="@(loginModel.Password ?? string.Empty)" />
                                <button type="button" class="btn btn-light password-toggle-btn px-3" tabindex="-1">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 my-2 fw-bold">Sign In <i class="bi bi-arrow-right ms-2"></i></button>
                    </form>

                    <div class="auth-card__footer text-center border-top">
                        <small class="text-muted">Don't have an account? <a href="/Account/Register" class="fw-bold text-success text-decoration-none">Register here</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    private LoginModel loginModel { get; set; } = new();

    private sealed class LoginModel
    {
        public string SchoolId { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
