@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using SyllabusRepository.DTOs
@using SRVS.Application.Services
@using SRVS.Domain.Enums

@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<div class="container auth-page">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="auth-brand text-center">
                <div class="usjr-seal usjr-seal--hero">
                    <div class="usjr-seal__ring">
                        <img src="images/cpe_logo.png?v=202606231815" class="usjr-seal__img" alt="Computer Engineering Department logo" />
                    </div>
                </div>
                <h1 class="display-6 mb-1">Syllabus Repository</h1>
                <p class="text-uppercase small mb-0">Computer Engineering</p>
            </div>

            <div class="card p-2">
                <div class="card-body p-4 p-md-5">
                    <h3 class="mb-4 text-center fw-bold" style="color:#0a4025;">Create an Account</h3>

                    @if (showSuccessMessage)
                    {
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            <div>Account created successfully. Please wait for admin approval before signing in.</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <div>@errorMessage</div>
                        </div>
                    }

                    <EditForm FormName="registerForm" Model="RegisterInput" method="post" OnValidSubmit="RegisterUser">
                        <DataAnnotationsValidator />
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" for="RegisterInput.FirstName">First name</label>
                                <InputText @bind-Value="RegisterInput.FirstName" id="RegisterInput.FirstName" class="form-control" placeholder="John" />
                                <ValidationMessage For="() => RegisterInput.FirstName" class="text-danger small" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-secondary fw-semibold" for="RegisterInput.LastName">Last name</label>
                                <InputText @bind-Value="RegisterInput.LastName" id="RegisterInput.LastName" class="form-control" placeholder="Doe" />
                                <ValidationMessage For="() => RegisterInput.LastName" class="text-danger small" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" for="RegisterInput.Email">Email address</label>
                            <InputText @bind-Value="RegisterInput.Email" id="RegisterInput.Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                            <ValidationMessage For="() => RegisterInput.Email" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" for="RegisterInput.SchoolId">School ID</label>
                            <InputText @bind-Value="RegisterInput.SchoolId" id="RegisterInput.SchoolId" class="form-control" placeholder="5 digits or 10 digits" autocomplete="username" />
                            <div class="form-text small text-muted">Department Head and Faculty use 5 digits; Student uses 10 digits.</div>
                            <ValidationMessage For="() => RegisterInput.SchoolId" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold" for="RegisterInput.Role">Role</label>
                            <InputSelect id="RegisterInput.Role" class="form-select" @bind-Value="RegisterInput.Role">
                                <option value="@UserRoleType.DepartmentHead">Department Head</option>
                                <option value="@UserRoleType.Educator">Faculty</option>
                                <option value="@UserRoleType.Student">Student</option>
                            </InputSelect>
                            <ValidationMessage For="() => RegisterInput.Role" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold" for="RegisterInput.Password">Password</label>
                            <div class="input-group password-input-group">
                                <InputText type="password" @bind-Value="RegisterInput.Password" id="RegisterInput.Password" class="form-control" autocomplete="new-password" placeholder="Create a password" />
                                <button type="button" class="btn btn-light password-toggle-btn px-3" tabindex="-1">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                            <div class="form-text small text-muted mt-1">Must be at least 8 chars, 1 uppercase, 1 number, and 1 special character.</div>
                            <ValidationMessage For="() => RegisterInput.Password" class="text-danger small" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-secondary fw-semibold" for="RegisterInput.ConfirmPassword">Confirm password</label>
                            <div class="input-group password-input-group">
                                <InputText type="password" @bind-Value="RegisterInput.ConfirmPassword" id="RegisterInput.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat password" />
                                <button type="button" class="btn btn-light password-toggle-btn px-3" tabindex="-1">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                            <ValidationMessage For="() => RegisterInput.ConfirmPassword" class="text-danger small" />
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold my-2" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Create Account <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </EditForm>

                    <div class="text-center mt-4 pt-3 border-top">
                        <small class="text-muted">Already have an account? <a href="/Account/Login" class="fw-bold text-success text-decoration-none">Log in here</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isSubmitting;
    private bool showSuccessMessage;
    private string? errorMessage;

    [SupplyParameterFromForm]
    private RegisterRequest RegisterInput { get; set; } = default!;

    protected override void OnInitialized()
    {
        RegisterInput ??= new RegisterRequest
        {
            Role = UserRoleType.DepartmentHead
        };
    }

    private async Task RegisterUser()
    {
        isSubmitting = true;
        errorMessage = null;
        showSuccessMessage = false;
        try
        {
            RegisterInput.SchoolId = RegisterInput.SchoolId?.Trim() ?? string.Empty;

            if (RegisterInput.Role is not (UserRoleType.DepartmentHead or UserRoleType.Educator or UserRoleType.Student))
            {
                errorMessage = "Please select a valid role.";
                return;
            }

            if (!InstitutionalIdRules.IsValid(RegisterInput.Role, RegisterInput.SchoolId))
            {
                errorMessage = GetSchoolIdValidationMessage(RegisterInput.Role);
                return;
            }

            var response = await Http.PostAsJsonAsync("/api/auth/register", RegisterInput);
            if (response.IsSuccessStatusCode)
            {
                showSuccessMessage = true;
                ResetRegisterForm();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = !string.IsNullOrWhiteSpace(body) ? body : "School ID or email already exists.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                var body = await response.Content.ReadAsStringAsync();
                errorMessage = !string.IsNullOrWhiteSpace(body) ? body : "Validation failed. Please check the fields and try again.";
            }
            else
            {
                errorMessage = "An unexpected error occurred. Please try again.";
            }
        }
        catch
        {
            errorMessage = "Unable to connect to the authentication server.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetRegisterForm()
    {
        RegisterInput = new RegisterRequest
        {
            Role = UserRoleType.DepartmentHead
        };
    }

    private static string GetSchoolIdValidationMessage(UserRoleType role) => role switch
    {
        UserRoleType.Student => "Students must use a 10-digit School ID.",
        UserRoleType.Educator => "Faculty must use a 5-digit School ID.",
        UserRoleType.DepartmentHead => "Department Heads must use a 5-digit School ID.",
        _ => "Please select a valid role."
    };
}
