<div class="usjr-seal @Class" aria-label="Computer Engineering Department USJ-R seal">
    <div class="usjr-seal__ring">
        <img src="images/cpeng-logo.jpg" alt="Computer Engineering Department USJ-R" class="usjr-seal__img" />
    </div>
    <div class="usjr-seal__caption">Computer Engineering Department</div>
    <div class="usjr-seal__subcaption">USJ-R</div>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }
}
