@implements IDisposable

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using System.Reflection
@using SRVS.Application.Services
@using SRVS.Web.Data

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager

<input id="logout-confirm-toggle" class="logout-confirm-toggle" type="checkbox" />

<div class="nav-shell">
    <a class="navbar-brand" href="/dashboard">
        <img class="navbar-logo" src="images/cpe_logo.png?v=202606231815" alt="Computer Engineering Department logo" />
        <span>
            <span class="navbar-title">SRVS</span>
            <span class="navbar-subtitle">USJR Computer Engineering Department</span>
        </span>
    </a>


    <AuthorizeView>
        <Authorized>
            @if (currentUser is not null)
            {
                    <div class="nav-user">
                        <div class="nav-user__avatar">@UserInitials</div>
                        <div class="nav-user__meta">
                            <div class="nav-user__name">@DisplayName</div>
                            <div class="nav-user__role">@RoleLabel</div>
                        </div>
                    </div>

                <div class="nav-section">
                    <div class="nav-section__label">Workspace</div>
                    <nav class="nav flex-column">
                        @foreach (var link in RoleLinks)
                        {
                            <div class="nav-item" key="@link.Href">
                                <NavLink class="nav-link" href="@link.Href" Match="@link.Match">
                                    <span class="nav-link__icon @link.Icon" aria-hidden="true"></span>
                                    <span>@link.Label</span>
                                </NavLink>
                            </div>
                        }
                    </nav>
                </div>
            }

            <div class="nav-section nav-section--account">
                <div class="nav-section__label">Account</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="nav-link__icon nav-link__icon--account" aria-hidden="true"></span>
                        <span>Profile settings</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <label class="nav-link nav-link--button" for="logout-confirm-toggle" role="button" tabindex="0">
                        <span class="nav-link__icon nav-link__icon--logout" aria-hidden="true"></span>
                        <span>Logout</span>
                    </label>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="nav-section">
                <div class="nav-section__label">Access</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Login" Match="NavLinkMatch.All">
                        <span class="nav-link__icon nav-link__icon--login" aria-hidden="true"></span>
                        <span>Login</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="nav-link__icon nav-link__icon--register" aria-hidden="true"></span>
                        <span>Register</span>
                    </NavLink>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <div class="nav-version">Version @AppVersion</div>
</div>

<div class="logout-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="logout-confirm-title">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="logout-confirm-title" class="modal-title h5">Log out of SRVS?</h2>
                <label class="btn-close" for="logout-confirm-toggle" aria-label="Close"></label>
            </div>
            <div class="modal-body">
                <p class="mb-0">Your current session will end and you will return to the login page.</p>
            </div>
            <div class="modal-footer">
                <label class="btn btn-secondary" for="logout-confirm-toggle" role="button">Cancel</label>
                <form action="/Account/Logout" method="post" class="m-0">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="Account/Login" />
                    <button type="submit" class="btn btn-danger">Logout</button>
                </form>
            </div>
        </div>
    </div>
</div>
<label class="logout-confirm-backdrop" for="logout-confirm-toggle" aria-label="Cancel logout"></label>

@code {
    private string? currentUrl;
    private ApplicationUser? currentUser;
    private static string AppVersion => Assembly.GetExecutingAssembly()
        .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
        .InformationalVersion ?? "1.0.0";

    private string DisplayName => currentUser?.FullName ?? currentUser?.Email ?? "SRVS User";

    private string UserInitials
    {
        get
        {
            var words = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return words.Length switch
            {
                0 => "SR",
                1 => words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant(),
                _ => $"{words[0][0]}{words[^1][0]}".ToUpperInvariant()
            };
        }
    }

    private string RoleLabel => currentUser?.Role switch
    {
        UserRoleType.Admin => "System Administrator",
        UserRoleType.DepartmentHead => "Department Head",
        UserRoleType.Educator => "Faculty",
        UserRoleType.Viewer => "Student Viewer",
        _ => "Approved User"
    };

    private IReadOnlyList<NavItem> RoleLinks => currentUser?.Role switch
    {
        UserRoleType.Admin =>
        [
            new("Dashboard", DashboardRouteResolver.GetRoute(UserRoleType.Admin), "nav-link__icon--dashboard", NavLinkMatch.All),
            new("Registration Approvals", "/admin/registrations", "nav-link__icon--users"),
            new("User Management", "/admin/user-management", "nav-link__icon--users")
        ],
        UserRoleType.DepartmentHead =>
        [
            new("Dashboard", DashboardRouteResolver.GetRoute(UserRoleType.DepartmentHead), "nav-link__icon--dashboard", NavLinkMatch.All),
            new("Assign Students", "/department-head/students", "nav-link__icon--users"),
            new("Upload Syllabus", "/department-head/upload", "nav-link__icon--upload"),
            new("Review Submissions", "/department-head/review-submissions", "nav-link__icon--review"),
            new("Syllabus Repository", "/department-head/syllabus-repository", "nav-link__icon--repository")
        ],
        UserRoleType.Educator =>
        [
            new("Dashboard", DashboardRouteResolver.GetRoute(UserRoleType.Educator), "nav-link__icon--dashboard", NavLinkMatch.All),
            new("Upload Syllabus", "/educator/upload", "nav-link__icon--upload"),
            new("Syllabus Repository", "/syllabi/search", "nav-link__icon--repository")
        ],
        UserRoleType.Viewer =>
        [
            new("Dashboard", DashboardRouteResolver.GetRoute(UserRoleType.Viewer), "nav-link__icon--dashboard", NavLinkMatch.All),
            new("Browse Syllabi", "/syllabi/search", "nav-link__icon--repository")
        ],
        _ =>
        [
            new("Dashboard", "/dashboard", "nav-link__icon--dashboard", NavLinkMatch.All),
            new("Syllabus Repository", "/syllabi/search", "nav-link__icon--repository")
        ]
    };

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        
        await using var scope = ServiceProvider.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        currentUser = await userManager.GetUserAsync(authState.User);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private sealed record NavItem(string Label, string Href, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);
}
