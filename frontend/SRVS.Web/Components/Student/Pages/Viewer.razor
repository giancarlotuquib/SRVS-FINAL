@page "/syllabi/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SRVS.Application.Abstractions
@using SRVS.Application.Services
@using SRVS.Domain.Entities
@using SRVS.Domain.Enums
@using SRVS.Web.Data

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISyllabusWorkflowService WorkflowService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager

<PageTitle>Syllabus Viewer & Version History</PageTitle>

@if (document is null)
{
    if (isLoading)
    {
        <div class="container py-5 text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="container py-5">
            <div class="alert alert-danger">The requested syllabus document could not be found or you do not have permission to view it.</div>
        </div>
    }
    return;
}

<section class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="syllabi/search">Repository</a></li>
                    <li class="breadcrumb-item active">@document.CourseCode</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0">@document.CourseTitle</h1>
            <p class="text-secondary mb-0">@document.AcademicYear - @document.Semester</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge @GetStatusBadgeClass(document.Status) fs-6 px-3 py-2">Status: @document.Status</span>
            
            @if (canReview)
            {
                <button class="btn btn-success" @onclick="() => InitiateApprove()" disabled="@isProcessing">
                    <i class="bi bi-check-circle me-1"></i> Accept
                </button>
                <button class="btn btn-danger" @onclick="() => InitiateReject()" disabled="@isProcessing">
                    <i class="bi bi-x-circle me-1"></i> Reject
                </button>
            }
            
            @if (canSubmit)
            {
                <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@isProcessing">
                    <i class="bi bi-send me-1"></i> Submit for Review
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="row g-4 h-100">
        <!-- Main Document Viewer -->
        <div class="@(comparisonVersionId.HasValue ? "col-lg-6" : "col-lg-8") d-flex flex-column" style="min-height: 75vh;">
            <div class="card border-0 shadow-sm flex-grow-1 d-flex flex-column overflow-hidden">
                <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary">
                        <i class="bi bi-file-earmark-pdf me-2"></i>Current Active Version (V@(document.CurrentVersionNumber))
                    </h5>
                    <div class="d-flex gap-2">
                        <a href="/syllabi/@document.Id/view" class="btn btn-sm btn-outline-primary" target="_blank">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Open
                        </a>
                        <a href="/syllabi/@document.Id/download" class="btn btn-sm btn-outline-secondary" target="_blank">
                            <i class="bi bi-download me-1"></i> Download
                        </a>
                    </div>
                </div>
                <div class="card-body p-0 flex-grow-1 position-relative" style="min-height: 500px;">
                    @if (document.CurrentFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        <iframe src="/syllabi/@document.Id/view" class="w-100 h-100 border-0 position-absolute top-0 start-0" title="PDF Viewer"></iframe>
                    }
                    else
                    {
                        <div class="d-flex h-100 align-items-center justify-content-center bg-light">
                            <div class="text-center p-4">
                                <i class="bi bi-file-earmark-word display-1 text-primary mb-3"></i>
                                <h4>Word Document</h4>
                                <p class="text-secondary">This file format cannot be previewed in the browser.</p>
                                <a href="/syllabi/@document.Id/download" class="btn btn-primary mt-2">Download to View</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Secondary Document Viewer (Side-by-Side Comparison) -->
        @if (comparisonVersionId.HasValue)
        {
            var compVersion = document.Versions.FirstOrDefault(v => v.Id == comparisonVersionId.Value);
            <div class="col-lg-6 d-flex flex-column" style="min-height: 75vh;">
                <div class="card border-0 shadow-sm flex-grow-1 d-flex flex-column overflow-hidden" style="border-left: 3px solid #145c3d !important;">
                    <div class="card-header bg-white border-bottom-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-secondary">
                            <i class="bi bi-clock-history me-2"></i>Historical Version (V@(compVersion?.VersionNumber))
                        </h5>
                        <div>
                            <a href="/syllabi/versions/@(compVersion?.Id)/download" class="btn btn-sm btn-outline-secondary me-2" target="_blank">
                                <i class="bi bi-download"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="CloseComparison">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 flex-grow-1 position-relative" style="min-height: 500px;">
                        @if (compVersion?.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            <iframe src="/syllabi/versions/@(compVersion.Id)/view" class="w-100 h-100 border-0 position-absolute top-0 start-0" title="Comparison PDF Viewer"></iframe>
                        }
                        else
                        {
                            <div class="d-flex h-100 align-items-center justify-content-center bg-light">
                                <div class="text-center p-4">
                                    <i class="bi bi-file-earmark-word display-1 text-secondary mb-3"></i>
                                    <h4>Word Document</h4>
                                    <a href="/syllabi/versions/@(compVersion?.Id)/download" class="btn btn-secondary mt-2">Download</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Side Panel: Metadata and History -->
        @if (!comparisonVersionId.HasValue)
        {
            <div class="col-lg-4 d-flex flex-column">
                @if (document.Status == SyllabusStatus.Rejected && !string.IsNullOrWhiteSpace(document.ReviewerRemarks))
                {
                    <div class="alert alert-danger shadow-sm border-0 mb-4">
                        <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Rejection Feedback</h6>
                        <p class="mb-0 small">@document.ReviewerRemarks</p>
                    </div>
                }

                @if (canRevise)
                {
                    <div class="card border-0 shadow-sm mb-4 bg-primary text-white" style="background: linear-gradient(135deg, #187147, #0d442a) !important;">
                        <div class="card-body text-center p-4">
                            <h5 class="mb-3">Update Syllabus</h5>
                            <p class="small mb-3 text-white-50">Upload a revised PDF to replace the current draft.</p>
                            <a href="@UploadRevisionHref" class="btn btn-light fw-bold px-4">Upload Revision</a>
                        </div>
                    </div>
                }

                <div class="card border-0 shadow-sm flex-grow-1 overflow-hidden d-flex flex-column">
                    <div class="card-header bg-white pt-4 pb-0 border-0">
                        <h5 class="mb-3">Version History</h5>
                    </div>
                    <div class="card-body overflow-auto p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var version in document.Versions.OrderByDescending(v => v.VersionNumber))
                            {
                                <div class="list-group-item p-4 @(version.VersionNumber == document.CurrentVersionNumber ? "bg-light" : "")">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="mb-0 fw-bold">Version @version.VersionNumber</h6>
                                        <span class="text-secondary small">@version.UploadedAtUtc.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <p class="small mb-1 text-dark"><strong>Uploaded by:</strong> @version.UploadedByName</p>
                                    
                                    @if (!string.IsNullOrWhiteSpace(version.ChangeSummary))
                                    {
                                        <p class="small mb-3 text-secondary border-start border-3 ps-2 mt-2">@version.ChangeSummary</p>
                                    }

                                    <div class="d-flex gap-2 mt-3">
                                        @if (isDepartmentHead || isOwner)
                                        {
                                            <a href="/syllabi/versions/@version.Id/download" class="btn btn-sm btn-outline-secondary" title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        }
                                        
                                        @if (version.VersionNumber != document.CurrentVersionNumber && (isDepartmentHead || isOwner))
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => CompareVersion(version.Id)" title="Side-by-side Compare">
                                                <i class="bi bi-layout-split"></i> Compare
                                            </button>
                                        }

                                        @if (version.VersionNumber != document.CurrentVersionNumber && isOwner && document.Status is SyllabusStatus.Draft or SyllabusStatus.Rejected)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => InitiateRestore(version)" title="Restore this version">
                                                <i class="bi bi-arrow-counterclockwise"></i> Restore
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Modals -->
    @if (showApproveModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title">Accept Syllabus</h5>
                        <button type="button" class="btn-close" @onclick="() => showApproveModal = false" disabled="@isProcessing"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to accept this syllabus? It will become immediately visible to all students.</p>
                    </div>
                    <div class="modal-footer border-top-0">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showApproveModal = false" disabled="@isProcessing">Cancel</button>
                        <button type="button" class="btn btn-success" @onclick="ConfirmApproveAsync" disabled="@isProcessing">Accept</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showRejectModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title">Reject Syllabus</h5>
                        <button type="button" class="btn-close" @onclick="() => showRejectModal = false" disabled="@isProcessing"></button>
                    </div>
                    <div class="modal-body">
                        <p>Please provide required modifications. This feedback will be sent to the educator.</p>
                        <textarea class="form-control" rows="4" @bind="rejectRemarks" placeholder="Enter required changes..."></textarea>
                    </div>
                    <div class="modal-footer border-top-0">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showRejectModal = false" disabled="@isProcessing">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmRejectAsync" disabled="@isProcessing">Reject Submission</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (versionToRestore is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header border-bottom-0">
                        <h5 class="modal-title">Restore Previous Version</h5>
                        <button type="button" class="btn-close" @onclick="() => versionToRestore = null" disabled="@isProcessing"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to promote <strong>Version @versionToRestore.VersionNumber</strong> to become the current active draft?</p>
                        <p class="small text-secondary mb-0">A new version will be created from this historical file. The existing version history will remain intact.</p>
                    </div>
                    <div class="modal-footer border-top-0">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => versionToRestore = null" disabled="@isProcessing">Cancel</button>
                        <button type="button" class="btn btn-warning" @onclick="ConfirmRestoreAsync" disabled="@isProcessing">Promote to Current Draft</button>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery]
    public string? Action { get; set; }

    private SyllabusDocument? document;
    private ApplicationUser? currentUser;
    private bool isLoading = true;
    private bool isProcessing;
    private string? errorMessage;
    private string? successMessage;

    private bool isDepartmentHead;
    private bool isOwner;
    private bool canReview;
    private bool canSubmit;
    private bool canRevise;
    private string UploadRevisionHref => isDepartmentHead
        ? $"/department-head/upload?documentId={document?.Id}"
        : $"/educator/upload?documentId={document?.Id}";

    private Guid? comparisonVersionId;

    private bool showApproveModal;
    private bool showRejectModal;
    private string rejectRemarks = string.Empty;

    private SyllabusVersion? versionToRestore;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        
        await using var scope = ServiceProvider.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        currentUser = await userManager.GetUserAsync(authState.User);
        
        if (currentUser is null) return;

        await LoadDocumentAsync();
        ApplyRequestedReviewAction();
    }

    private async Task LoadDocumentAsync()
    {
        isLoading = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            document = await dbContext.SyllabusDocuments
                .Include(d => d.Versions)
                .FirstOrDefaultAsync(d => d.Id == Id);

            if (document is not null)
            {
                isDepartmentHead = currentUser!.Role == UserRoleType.DepartmentHead;
                isOwner = currentUser.Id == document.OwnerUserId;
                canReview = document.Status == SyllabusStatus.Submitted && currentUser.Role == UserRoleType.DepartmentHead;
                canSubmit = SyllabusAccessPolicy.CanSubmit(document, currentUser.Role, currentUser.Id);
                canRevise = SyllabusAccessPolicy.CanRevise(document, currentUser.Role, currentUser.Id);

                if (!await CanCurrentUserViewDocumentAsync(dbContext))
                {
                    document = null;
                    canReview = false;
                    canSubmit = false;
                    canRevise = false;
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<bool> CanCurrentUserViewDocumentAsync(ApplicationDbContext dbContext)
    {
        if (currentUser is null || document is null)
        {
            return false;
        }

        if (currentUser.Role != UserRoleType.Student)
        {
            return currentUser.Role switch
            {
                UserRoleType.Admin => true,
                UserRoleType.DepartmentHead => true,
                UserRoleType.Educator => document.OwnerUserId == currentUser.Id,
                _ => false
            };
        }

        return document.Status == SyllabusStatus.Approved
            && document.IsPublished
            && await dbContext.SyllabusAssignments.AnyAsync(
                assignment => assignment.StudentId == currentUser.Id
                    && assignment.SyllabusDocId == document.Id
                    && assignment.IsActive
                    && assignment.DeletedAt == null);
    }

    private string GetStatusBadgeClass(SyllabusStatus status) => status switch
    {
        SyllabusStatus.Draft => "text-bg-secondary",
        SyllabusStatus.Submitted => "text-bg-warning text-dark",
        SyllabusStatus.Approved => "text-bg-success text-white",
        SyllabusStatus.Rejected => "text-bg-danger text-white",
        _ => "text-bg-light"
    };

    private void CompareVersion(Guid versionId)
    {
        comparisonVersionId = versionId;
    }

    private void CloseComparison()
    {
        comparisonVersionId = null;
    }

    // Workflows
    private async Task SubmitAsync()
    {
        if (isProcessing || currentUser is null || document is null) return;
        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await WorkflowService.SubmitAsync(document.Id, currentUser.Id, currentUser.FullName);
            successMessage = "Syllabus successfully submitted for departmental review.";
            await LoadDocumentAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void InitiateApprove() => showApproveModal = true;
    private void InitiateReject()
    {
        rejectRemarks = string.Empty;
        showRejectModal = true;
    }

    private void ApplyRequestedReviewAction()
    {
        if (!canReview || string.IsNullOrWhiteSpace(Action))
        {
            return;
        }

        if (Action.Equals("approve", StringComparison.OrdinalIgnoreCase) || Action.Equals("accept", StringComparison.OrdinalIgnoreCase))
        {
            showApproveModal = true;
        }
        else if (Action.Equals("reject", StringComparison.OrdinalIgnoreCase))
        {
            InitiateReject();
        }
    }

    private async Task ConfirmApproveAsync()
    {
        if (isProcessing || currentUser is null || document is null) return;
        isProcessing = true;
        errorMessage = null;

        try
        {
            await WorkflowService.ApproveAsync(document.Id, currentUser.Id, currentUser.FullName);
            successMessage = "Syllabus has been approved and published.";
            showApproveModal = false;
            await LoadDocumentAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmRejectAsync()
    {
        if (isProcessing || currentUser is null || document is null) return;
        
        if (string.IsNullOrWhiteSpace(rejectRemarks))
        {
            errorMessage = "Rejection remarks are required.";
            return;
        }

        isProcessing = true;
        errorMessage = null;

        try
        {
            await WorkflowService.RejectAsync(document.Id, currentUser.Id, currentUser.FullName, rejectRemarks);
            successMessage = "Syllabus has been rejected and reverted to draft status.";
            showRejectModal = false;
            await LoadDocumentAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void InitiateRestore(SyllabusVersion version) => versionToRestore = version;

    private async Task ConfirmRestoreAsync()
    {
        if (isProcessing || currentUser is null || document is null || versionToRestore is null) return;
        isProcessing = true;
        errorMessage = null;

        try
        {
            await WorkflowService.RestoreVersionAsync(versionToRestore.Id, currentUser.Id, currentUser.FullName);
            successMessage = $"Successfully restored Version {versionToRestore.VersionNumber}.";
            versionToRestore = null;
            await LoadDocumentAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
}
