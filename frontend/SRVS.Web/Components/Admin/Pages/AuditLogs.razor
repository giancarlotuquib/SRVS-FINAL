@page "/admin/audit-logs"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.EntityFrameworkCore
@using SRVS.Domain.Entities
@using SRVS.Domain.Enums
@using SRVS.Web.Data

@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>System Audit Logs</PageTitle>

<section class="container py-4">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 p-md-5">
            <p class="text-uppercase text-secondary small mb-1">Admin Dashboard</p>
            <h1 class="h3 mb-2">System Audit Logs</h1>
            <p class="text-secondary mb-0">Immutable record of all system events, authentication attempts, and file modifications.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <EditForm Model="filter" OnSubmit="ApplyFilterAsync" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Search Query</label>
                    <InputText class="form-control" @bind-Value="filter.SearchTerm" placeholder="User, description..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Action Type</label>
                    <InputSelect class="form-select" @bind-Value="filter.ActionType">
                        <option value="">All Actions</option>
                        @foreach (var type in Enum.GetValues<AuditActionType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select" @bind-Value="filter.ResultStatus">
                        <option value="">All Results</option>
                        @foreach (var status in Enum.GetValues<AuditResultStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Timestamp (UTC)</th>
                            <th>Actor</th>
                            <th>Action Type</th>
                            <th>Description</th>
                            <th>Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (logs.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">No audit logs match the current filter.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in logs)
                            {
                                <tr>
                                    <td class="text-secondary small text-nowrap">@log.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="fw-semibold">@(log.UserDisplayName ?? "System")</td>
                                    <td><span class="badge text-bg-light">@log.ActionType</span></td>
                                    <td class="small">@log.Description</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(log.ResultStatus)">@log.ResultStatus</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            @if (hasMoreLogs)
            {
                <div class="p-3 text-center border-top">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadMoreAsync">Load More</button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private System.Threading.Timer? refreshTimer;
    private const int RefreshIntervalMs = 3000;

    private bool isDisposed;

    private List<AuditLogEntry> logs = [];
    private AuditFilter filter = new();
    private int currentCount = 50;
    private bool hasMoreLogs;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogsAsync();
        StartPolling();
    }

    private async Task ApplyFilterAsync()
    {
        currentCount = 50;
        await LoadLogsAsync();
    }

    private async Task LoadMoreAsync()
    {
        currentCount += 50;
        await LoadLogsAsync();
    }

    private void StartPolling()
    {
        refreshTimer?.Dispose();

        refreshTimer = new System.Threading.Timer(async _ =>
        {
            if (isDisposed) return;

            try
            {
                await InvokeAsync(async () =>
                {
                    await LoadLogsAsync();
                    StateHasChanged();
                });
            }
            catch
            {
            }
        }, null, RefreshIntervalMs, RefreshIntervalMs);
    }

    private void StopPolling()
    {
        refreshTimer?.Dispose();
        refreshTimer = null;
    }

    public void Dispose()
    {
        isDisposed = true;
        StopPolling();
    }

    private async Task LoadLogsAsync()
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var query = dbContext.AuditLogEntries.AsNoTracking().AsQueryable();

        if (!string.IsNullOrWhiteSpace(filter.SearchTerm))
        {
            var search = filter.SearchTerm.Trim();
            query = query.Where(item => (item.UserDisplayName != null && item.UserDisplayName.Contains(search)) || item.Description.Contains(search));
        }

        if (filter.ActionType.HasValue)
        {
            query = query.Where(item => item.ActionType == filter.ActionType.Value);
        }

        if (filter.ResultStatus.HasValue)
        {
            query = query.Where(item => item.ResultStatus == filter.ResultStatus.Value);
        }

        var allLogs = await query.ToListAsync();
        var totalCount = allLogs.Count;
        logs = allLogs.OrderByDescending(item => item.CreatedAtUtc).Take(currentCount).ToList();
        hasMoreLogs = totalCount > logs.Count;
    }

    private string GetStatusBadgeClass(AuditResultStatus status) => status switch
    {
        AuditResultStatus.Success => "text-bg-success",
        AuditResultStatus.Failed => "text-bg-danger",
        AuditResultStatus.Warning => "text-bg-warning text-dark",
        _ => "text-bg-secondary"
    };

    private sealed class AuditFilter
    {
        public string SearchTerm { get; set; } = string.Empty;
        public AuditActionType? ActionType { get; set; }
        public AuditResultStatus? ResultStatus { get; set; }
    }
}
