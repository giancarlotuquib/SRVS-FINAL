@page "/admin/user-management"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using SRVS.Domain.Entities
@using SRVS.Domain.Enums
@using SRVS.Web.Components.Admin.Services
@using SRVS.Web.Data

@inject UserActionService UserActionService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>User Management</PageTitle>

<section class="container py-4">
    <h1 class="h3 mb-4">User Management</h1>
    <p class="text-secondary mb-4">Manage approved and active user accounts. Pending registration requests are handled in <a href="/admin/registrations">Registration Approvals</a>.</p>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (users.Count == 0)
    {
        <div class="alert alert-info">
            <strong>No users found.</strong> All pending registrations are shown in <a href="/admin/registrations">Registration Approvals</a> before they appear here.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>School ID</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td class="fw-semibold">@user.UserName</td>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.InstitutionalId</td>
                            <td>@user.Role</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(user.AccountStatus)">@user.AccountStatus</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (user.AccountStatus != UserAccountStatus.Active)
                                    {
                                        <button type="button" class="btn btn-outline-success" @onclick="() => OpenConfirmation(user, UserAccountStatus.Active)" disabled="@isProcessing" title="Activate this user">
                                            Activate
                                        </button>
                                    }
                                    @if (user.AccountStatus == UserAccountStatus.Active)
                                    {
                                        <button type="button" class="btn btn-outline-warning" @onclick="() => OpenConfirmation(user, UserAccountStatus.Suspended)" disabled="@isProcessing" title="Deactivate this user">
                                            Deactivate
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => OpenConfirmation(user, UserAccountStatus.Deleted)" disabled="@isProcessing" title="Delete this user">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <ConfirmationModal 
        IsVisible="showConfirmModal" 
        IsProcessing="isProcessing"
        SelectedUser="pendingUser"
        TargetStatus="pendingStatus ?? UserAccountStatus.Active"
        OnCancel="CloseConfirmationAsync"
        OnConfirm="ApplyConfirmedActionAsync" />
</section>

@code {
    private List<ApplicationUser> users = [];
    private bool isProcessing;
    private bool showConfirmModal;
    private ApplicationUser? pendingUser;
    private UserAccountStatus? pendingStatus;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;

        if (currentUser.Identity?.IsAuthenticated != true || !currentUser.IsInRole("Admin"))
        {
            return;
        }

        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            users = await UserActionService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            successMessage = $"Error loading users: {ex.Message}";
        }
    }

    private void OpenConfirmation(ApplicationUser user, UserAccountStatus targetStatus)
    {
        if (isProcessing)
        {
            return;
        }

        pendingUser = user;
        pendingStatus = targetStatus;
        showConfirmModal = true;
    }

    private async Task CloseConfirmationAsync()
    {
        showConfirmModal = false;
        pendingUser = null;
        pendingStatus = null;
        await Task.CompletedTask;
    }

    private async Task ApplyConfirmedActionAsync()
    {
        if (pendingUser is null || pendingStatus is null || isProcessing)
        {
            return;
        }

        isProcessing = true;
        StateHasChanged();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var currentUser = authState.User;
            var reviewerId = currentUser.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "System";
            var reviewerName = currentUser.Identity?.Name ?? "System Administrator";

            var updatedUser = await UserActionService.UpdateUserStatusAsync(pendingUser.Id, pendingStatus.Value, reviewerId, reviewerName);

            if (updatedUser is null)
            {
                successMessage = "Error: User not found.";
                await CloseConfirmationAsync();
                return;
            }

            await LoadUsersAsync();

            successMessage = pendingStatus.Value switch
            {
                UserAccountStatus.Deleted => $"✓ User '{pendingUser.UserName}' was deleted and database updated.",
                UserAccountStatus.Active => $"✓ User '{pendingUser.UserName}' was activated and database updated.",
                UserAccountStatus.Suspended => $"✓ User '{pendingUser.UserName}' was deactivated and database updated.",
                _ => $"✓ User '{pendingUser.UserName}' status was updated."
            };

            await CloseConfirmationAsync();
        }
        catch (Exception ex)
        {
            successMessage = $"Error updating user: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private static string GetStatusBadgeClass(UserAccountStatus status) => status switch
    {
        UserAccountStatus.Active => "text-bg-success",
        UserAccountStatus.PendingApproval => "text-bg-warning text-dark",
        UserAccountStatus.Suspended => "text-bg-secondary",
        UserAccountStatus.Rejected => "text-bg-danger",
        UserAccountStatus.Deleted => "text-bg-dark",
        _ => "text-bg-secondary"
    };
}
