<div class="usjr-seal @Class" aria-label="University of San Jose-Recoletos seal">
    <div class="usjr-seal__ring">
        <div class="usjr-seal__inner">
            <span class="usjr-seal__motto usjr-seal__motto--top">Caritas</span>
            <span class="usjr-seal__title">USJR</span>
            <span class="usjr-seal__motto usjr-seal__motto--bottom">Scientia</span>
        </div>
    </div>
    <div class="usjr-seal__caption">University of San Jose-Recoletos</div>
    <div class="usjr-seal__subcaption">Cebu City</div>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }
}
