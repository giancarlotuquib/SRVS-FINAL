@page "/department-head/review-submissions"
@attribute [Authorize]
@rendermode InteractiveServer

@using SRVS.Web.Components.Student.Pages

<PageTitle>Review Submissions</PageTitle>

<section class="container py-4">
	<div class="card border-warning-subtle bg-warning-subtle mb-3">
		<div class="card-body">
			<h1 class="h4 mb-2">Review Submissions</h1>
			<p class="mb-0 text-secondary">
				This queue is for pending faculty submissions. Use this page to review each submission and proceed with
				acceptance or rejection decisions.
			</p>
		</div>
	</div>
</section>

<Search />
