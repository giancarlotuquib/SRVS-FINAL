@page "/depthead/students"
@page "/department-head/students"
@using SRVS.Web.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SRVS.Domain.Entities
@using SRVS.Domain.Enums
@using SRVS.Web.Data
@namespace SRVS.Web.Components.DeptHead.Pages

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<div class="container py-4">
    <h2>Department - Students</h2>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success">@SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Active Students</h5>
            <div class="mb-2">
                <button class="btn btn-sm btn-primary" @onclick="OpenBulkAssign" disabled="@(!SelectedStudentIds.Any())">Assign to selected (@SelectedStudentIds.Count)</button>
            </div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th><input type="checkbox" @onchange="ToggleSelectAll" /></th>
                        <th>Full Name</th>
                        <th>School ID</th>
                        <th>Email</th>
                        <th>Assigned Syllabus</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Students)
                    {
                        <tr>
                            <td><input type="checkbox" checked="@SelectedStudentIds.Contains(s.Id)" @onchange="(e) => ToggleStudentSelection(s.Id, ((ChangeEventArgs)e).Value)" /></td>
                            <td>@s.FullName</td>
                            <td>@s.SchoolId</td>
                            <td>@s.Email</td>
                            <td>@(string.IsNullOrEmpty(s.AssignedSyllabusTitle) ? "No syllabus assigned" : s.AssignedSyllabusTitle)</td>
                            <td>
                                @if (s.Status == "Assigned")
                                {
                                    <span class="badge bg-success">Assigned</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unassigned</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Actions">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenAssignModal(s.Id, s.FullName)">@(s.Status=="Assigned"?"Reassign":"Assign Syllabus")</button>
                                    <button class="btn btn-sm btn-warning" @onclick='() => OpenStudentActionConfirmation(s.Id, s.FullName, "deactivate")'>Deactivate</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick='() => OpenStudentActionConfirmation(s.Id, s.FullName, "delete")'>Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (ShowModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Select Syllabus to assign @ModalStudentName</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Subject Code</th>
                                    <th>Subject Title</th>
                                    <th>Faculty</th>
                                    <th>Academic Year</th>
                                    <th>Semester</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var syl in Syllabi)
                                {
                                    <tr>
                                        <td>@syl.SubjectCode</td>
                                        <td>@syl.SubjectTitle</td>
                                        <td>@syl.FacultyName</td>
                                        <td>@syl.AcademicYear</td>
                                        <td>@syl.Semester</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary" @onclick="() => SelectSyllabus(syl.Id)">Select</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowConfirmModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@ConfirmTitle</h5>
                        <button type="button" class="btn-close" @onclick="CloseStudentActionConfirmation"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">@ConfirmMessage</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseStudentActionConfirmation">Cancel</button>
                        <button class="btn @ConfirmButtonClass" @onclick="ConfirmStudentActionAsync">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<StudentResponse> Students { get; set; } = new();
    private List<SyllabusListResponse> Syllabi { get; set; } = new();
    private ApplicationUser? CurrentDeptHead { get; set; }
    private bool ShowModal { get; set; }
    private string ModalStudentId { get; set; } = string.Empty;
    private string ModalStudentName { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;
    private string ErrorMessage { get; set; } = string.Empty;
    private HashSet<string> SelectedStudentIds { get; set; } = new();
    private bool ShowConfirmModal { get; set; }
    private string ConfirmStudentId { get; set; } = string.Empty;
    private string ConfirmStudentName { get; set; } = string.Empty;
    private string PendingStudentAction { get; set; } = string.Empty;
    private string ConfirmTitle { get; set; } = string.Empty;
    private string ConfirmMessage { get; set; } = string.Empty;
    private string ConfirmButtonClass { get; set; } = "btn-primary";

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentUserContextAsync();
        await LoadStudents();
        await LoadSyllabi();
    }

    private async Task LoadCurrentUserContextAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CurrentDeptHead = await UserManager.GetUserAsync(authState.User);
    }

    private async Task LoadStudents()
    {
        ErrorMessage = string.Empty;

        if (CurrentDeptHead is null || CurrentDeptHead.Role != UserRoleType.DepartmentHead)
        {
            Students = new();
            ErrorMessage = "Unauthorized access to Department Head student assignment page.";
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var deptId = CurrentDeptHead.DepartmentId;

        Students = await dbContext.Users
            .Where(u => u.Role == UserRoleType.Viewer && u.DepartmentId == deptId && u.AccountStatus == UserAccountStatus.Active)
            .Select(u => new StudentResponse
            {
                Id = u.Id,
                FullName = u.FullName,
                SchoolId = u.InstitutionalId,
                Email = u.Email,
                Department = dbContext.Departments.Where(d => d.Id == u.DepartmentId).Select(d => d.Name).FirstOrDefault() ?? string.Empty,
                AssignedSyllabusId = dbContext.SyllabusAssignments.Where(a => a.StudentId == u.Id && a.IsActive).Select(a => a.SyllabusId).FirstOrDefault(),
                AssignedSyllabusTitle = dbContext.SyllabusAssignments
                    .Where(a => a.StudentId == u.Id && a.IsActive)
                    .Join(dbContext.SyllabusDocuments, a => a.SyllabusId, s => s.Id, (_, s) => s.CourseTitle)
                    .FirstOrDefault(),
                Status = dbContext.SyllabusAssignments.Any(a => a.StudentId == u.Id && a.IsActive) ? "Assigned" : "Unassigned"
            })
            .ToListAsync();

        foreach (var s in Students)
        {
            if (s.AssignedSyllabusId == Guid.Empty)
            {
                s.AssignedSyllabusId = null;
            }
        }
    }

    private async Task LoadSyllabi()
    {
        if (CurrentDeptHead is null || CurrentDeptHead.Role != UserRoleType.DepartmentHead)
        {
            Syllabi = new();
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var deptId = CurrentDeptHead.DepartmentId;

        Syllabi = await dbContext.SyllabusDocuments
            .Where(s => s.DepartmentId == deptId && s.Status == SyllabusStatus.Submitted && !string.IsNullOrEmpty(s.OwnerUserId))
            .OrderByDescending(s => s.SubmittedAtUtc ?? s.UpdatedAtUtc)
            .Select(s => new SyllabusListResponse
            {
                Id = s.Id,
                SubjectCode = s.CourseCode,
                SubjectTitle = s.CourseTitle,
                FacultyName = s.InstructorName,
                AcademicYear = s.AcademicYear,
                Semester = s.Semester,
                UploadedAt = s.SubmittedAtUtc ?? DateTimeOffset.MinValue
            })
            .ToListAsync();
    }

    private void OpenAssignModal(string studentId, string studentName)
    {
        ModalStudentId = studentId;
        ModalStudentName = studentName;
        ShowModal = true;
    }

    private void OpenBulkAssign()
    {
        ModalStudentId = string.Empty; // indicate bulk
        ModalStudentName = $"(bulk: {SelectedStudentIds.Count} students)";
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
    }

    private async Task SelectSyllabus(Guid syllabusId)
    {
        ErrorMessage = string.Empty;

        if (CurrentDeptHead is null || CurrentDeptHead.Role != UserRoleType.DepartmentHead)
        {
            ErrorMessage = "Unauthorized action.";
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();

        if (string.IsNullOrEmpty(ModalStudentId))
        {
            var syllabus = await dbContext.SyllabusDocuments.FirstOrDefaultAsync(s => s.Id == syllabusId);
            if (syllabus is null || syllabus.DepartmentId != CurrentDeptHead.DepartmentId)
            {
                ErrorMessage = "Syllabus not found or unauthorized.";
                return;
            }

            var students = await dbContext.Users
                .Where(u => SelectedStudentIds.Contains(u.Id) && u.DepartmentId == CurrentDeptHead.DepartmentId)
                .ToListAsync();

            var now = DateTimeOffset.UtcNow;
            var created = 0;
            foreach (var student in students)
            {
                var existing = await dbContext.SyllabusAssignments.Where(a => a.StudentId == student.Id && a.IsActive).ToListAsync();
                foreach (var e in existing)
                {
                    e.IsActive = false;
                    e.DeletedAt = now;
                }

                dbContext.SyllabusAssignments.Add(new SyllabusAssignment
                {
                    StudentId = student.Id,
                    SyllabusId = syllabus.Id,
                    AssignedBy = CurrentDeptHead.Id,
                    AssignedAt = now,
                    IsActive = true
                });
                created++;
            }

            await dbContext.SaveChangesAsync();
            SuccessMessage = $"Syllabus successfully assigned to {created} students.";
            SelectedStudentIds.Clear();
            await LoadStudents();
        }
        else
        {
            var student = await dbContext.Users.FirstOrDefaultAsync(u => u.Id == ModalStudentId);
            if (student is null || student.DepartmentId != CurrentDeptHead.DepartmentId)
            {
                ErrorMessage = "Student not found or unauthorized.";
                return;
            }

            var syllabus = await dbContext.SyllabusDocuments.FirstOrDefaultAsync(s => s.Id == syllabusId);
            if (syllabus is null || syllabus.DepartmentId != CurrentDeptHead.DepartmentId)
            {
                ErrorMessage = "Syllabus not found or unauthorized.";
                return;
            }

            var existing = await dbContext.SyllabusAssignments.Where(a => a.StudentId == student.Id && a.IsActive).ToListAsync();
            foreach (var e in existing)
            {
                e.IsActive = false;
                e.DeletedAt = DateTimeOffset.UtcNow;
            }

            dbContext.SyllabusAssignments.Add(new SyllabusAssignment
            {
                StudentId = student.Id,
                SyllabusId = syllabus.Id,
                AssignedBy = CurrentDeptHead.Id,
                AssignedAt = DateTimeOffset.UtcNow,
                IsActive = true
            });

            await dbContext.SaveChangesAsync();
            SuccessMessage = $"Syllabus successfully assigned to {student.FullName}.";
            await LoadStudents();
        }

        ShowModal = false;
        StateHasChanged();
    }

    private void OpenStudentActionConfirmation(string studentId, string fullName, string action)
    {
        ConfirmStudentId = studentId;
        ConfirmStudentName = fullName;
        PendingStudentAction = action;
        ShowConfirmModal = true;

        if (action == "deactivate")
        {
            ConfirmTitle = "Deactivate Student";
            ConfirmMessage = $"Suspend {fullName}? They will be removed from Active Students list.";
            ConfirmButtonClass = "btn-warning";
        }
        else
        {
            ConfirmTitle = "Delete Student";
            ConfirmMessage = $"Soft-delete {fullName}? This keeps the audit trail.";
            ConfirmButtonClass = "btn-danger";
        }
    }

    private void CloseStudentActionConfirmation()
    {
        ShowConfirmModal = false;
        ConfirmStudentId = string.Empty;
        ConfirmStudentName = string.Empty;
        PendingStudentAction = string.Empty;
    }

    private async Task ConfirmStudentActionAsync()
    {
        if (string.IsNullOrEmpty(ConfirmStudentId) || string.IsNullOrEmpty(PendingStudentAction))
        {
            return;
        }

        if (CurrentDeptHead is null || CurrentDeptHead.Role != UserRoleType.DepartmentHead)
        {
            ErrorMessage = "Unauthorized action.";
            CloseStudentActionConfirmation();
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        var target = await dbContext.Users.FirstOrDefaultAsync(u => u.Id == ConfirmStudentId);
        if (target is null || target.DepartmentId != CurrentDeptHead.DepartmentId || target.Role != UserRoleType.Viewer)
        {
            ErrorMessage = "Student not found or unauthorized.";
            CloseStudentActionConfirmation();
            return;
        }

        if (PendingStudentAction == "deactivate")
        {
            target.AccountStatus = UserAccountStatus.Suspended;
        }
        else if (PendingStudentAction == "delete")
        {
            target.AccountStatus = UserAccountStatus.Deleted;
        }

        await dbContext.SaveChangesAsync();

        Students.RemoveAll(s => s.Id == ConfirmStudentId);
        SelectedStudentIds.Remove(ConfirmStudentId);
        SuccessMessage = PendingStudentAction == "deactivate"
            ? $"Student {ConfirmStudentName} suspended."
            : $"Student {ConfirmStudentName} deleted.";
        StateHasChanged();

        CloseStudentActionConfirmation();
    }

    private void ToggleStudentSelection(string studentId, object? value)
    {
        var isChecked = value is bool b && b;
        if (isChecked)
            SelectedStudentIds.Add(studentId);
        else
            SelectedStudentIds.Remove(studentId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var isChecked = e?.Value is bool b && b;
        SelectedStudentIds.Clear();
        if (isChecked == true)
        {
            foreach (var s in Students) SelectedStudentIds.Add(s.Id);
        }
    }
}
