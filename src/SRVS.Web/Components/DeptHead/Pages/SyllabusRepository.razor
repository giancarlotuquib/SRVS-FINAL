@page "/department-head/syllabus-repository"
@attribute [Authorize]
@rendermode InteractiveServer

@using SRVS.Web.Components.Student.Pages

<PageTitle>Syllabus Repository</PageTitle>

<section class="container py-4">
	<div class="card border-info-subtle bg-info-subtle mb-3">
		<div class="card-body">
			<h1 class="h4 mb-2">Syllabus Repository</h1>
			<p class="mb-0 text-secondary">
				This repository lists faculty-uploaded syllabi that are already uploaded and available for reference.
				Use this page for browsing and download, not for submission decisions.
			</p>
		</div>
	</div>
</section>

<Search />
