@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using SyllabusRepository.DTOs
@using SRVS.Domain.Enums

@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Register</PageTitle>

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-journal-bookmark-fill display-4 text-success"></i>
                        <h1 class="h3 mt-3 mb-1 fw-bold" style="font-weight:500;">Syllabus Repository</h1>
                        <p class="text-warning small text-uppercase fw-semibold" style="letter-spacing:0.1em;">ACADEMIC DOCUMENT MANAGEMENT</p>
                    </div>

                    @if (showSuccessMessage)
                    {
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle me-2"></i>
                            <div>Account created successfully. Please wait for admin approval before signing in.</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <div>@errorMessage</div>
                        </div>
                    }

                    <EditForm FormName="registerForm" Model="RegisterInput" method="post" OnValidSubmit="RegisterUser">
                        <DataAnnotationsValidator />
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="RegisterInput.FirstName">First name</label>
                                <InputText @bind-Value="RegisterInput.FirstName" id="RegisterInput.FirstName" class="form-control" placeholder="John" />
                                <ValidationMessage For="() => RegisterInput.FirstName" class="text-danger small" />
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="RegisterInput.LastName">Last name</label>
                                <InputText @bind-Value="RegisterInput.LastName" id="RegisterInput.LastName" class="form-control" placeholder="Doe" />
                                <ValidationMessage For="() => RegisterInput.LastName" class="text-danger small" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="RegisterInput.Email">Email address</label>
                            <InputText @bind-Value="RegisterInput.Email" id="RegisterInput.Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                            <ValidationMessage For="() => RegisterInput.Email" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="RegisterInput.SchoolId">School ID</label>
                            <InputText @bind-Value="RegisterInput.SchoolId" id="RegisterInput.SchoolId" class="form-control" placeholder="YYYY-XXXXX" autocomplete="username" />
                            <ValidationMessage For="() => RegisterInput.SchoolId" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="RegisterInput.Role">Role</label>
                            <InputSelect @bind-Value="RegisterInput.Role" id="RegisterInput.Role" class="form-select">
                                <option value="" disabled>Select role</option>
                                <option value="@UserRoleType.DepartmentHead">Department Head</option>
                                <option value="@UserRoleType.Educator">Faculty</option>
                                <option value="@UserRoleType.Viewer">Student</option>
                            </InputSelect>
                            <ValidationMessage For="() => RegisterInput.Role" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="RegisterInput.Password">Password</label>
                            <div class="input-group">
                                <InputText type="@(showPassword ? "text" : "password")" @bind-Value="RegisterInput.Password" id="RegisterInput.Password" class="form-control" autocomplete="new-password" placeholder="Create a password" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
                                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <div class="form-text small text-muted mt-1">Must be at least 8 chars, 1 uppercase, 1 number, and 1 special character.</div>
                            <ValidationMessage For="() => RegisterInput.Password" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="RegisterInput.ConfirmPassword">Confirm password</label>
                            <div class="input-group">
                                <InputText type="@(showConfirmPassword ? "text" : "password")" @bind-Value="RegisterInput.ConfirmPassword" id="RegisterInput.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat password" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="ToggleConfirmPasswordVisibility">
                                    <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="() => RegisterInput.ConfirmPassword" class="text-danger small" />
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Submit
                        </button>
                    </EditForm>

                    <hr class="my-4" />
                    <div class="text-center">
                        <small>Already have an account? <a href="/Account/Login">Log in here</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isSubmitting;
    private bool showPassword;
    private bool showConfirmPassword;
    private bool showSuccessMessage;
    private string? errorMessage;

    [SupplyParameterFromForm]
    private RegisterRequest RegisterInput { get; set; } = new RegisterRequest();

    private void TogglePasswordVisibility() => showPassword = !showPassword;
    private void ToggleConfirmPasswordVisibility() => showConfirmPassword = !showConfirmPassword;

    private async Task RegisterUser()
    {
        isSubmitting = true;
        errorMessage = null;
        showSuccessMessage = false;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/register", RegisterInput);
            if (response.IsSuccessStatusCode)
            {
                showSuccessMessage = true;
                RegisterInput = new RegisterRequest(); // clear fields
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = "School ID or email already exists.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                errorMessage = "Validation failed. Please check the fields and try again.";
            }
            else
            {
                errorMessage = "An unexpected error occurred. Please try again.";
            }
        }
        catch
        {
            errorMessage = "Unable to connect to the authentication server.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
