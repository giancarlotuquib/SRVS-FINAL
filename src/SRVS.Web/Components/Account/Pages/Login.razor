@page "/Account/Login"

@using Microsoft.AspNetCore.Components
@using SRVS.Domain.Enums

@inject NavigationManager NavigationManager

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-journal-bookmark-fill display-4 text-success"></i>
                        <h1 class="h3 mt-3 mb-1 fw-bold" style="font-weight:500;">Syllabus Repository</h1>
                        <p class="text-warning small text-uppercase fw-semibold" style="letter-spacing:0.1em;">ACADEMIC DOCUMENT MANAGEMENT</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <div>@ErrorMessage</div>
                        </div>
                    }

                    <form method="post" action="/Account/Login">

                        <div class="mb-3">
                            <label class="form-label" for="SchoolId">School ID</label>
                            <input type="text" name="SchoolId" id="SchoolId" class="form-control" placeholder="ID number" autocomplete="username" value="@(loginModel.SchoolId ?? string.Empty)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Role">Sign in as</label>
                            <select name="Role" id="Role" class="form-select">
                                <option value="Admin" selected="@(loginModel.Role == UserRoleType.Admin)">Admin</option>
                                <option value="DepartmentHead" selected="@(loginModel.Role == UserRoleType.DepartmentHead)">Department Head</option>
                                <option value="Educator" selected="@(loginModel.Role == UserRoleType.Educator)">Faculty</option>
                                <option value="Viewer" selected="@(loginModel.Role == UserRoleType.Viewer)">Student</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-flex justify-content-between" for="Password">
                                <span>Password</span>
                                <a class="small text-decoration-none" href="/Account/ForgotPassword">Forgot password?</a>
                            </label>
                            <div class="input-group password-input-group">
                                <input type="password" name="Password" id="Password" class="form-control" autocomplete="current-password" placeholder="Password" value="@(loginModel.Password ?? string.Empty)" />
                                <button type="button" class="btn btn-light password-toggle-btn" tabindex="-1">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 my-3">Log In</button>
                    </form>

                    <hr class="my-4" />
                    <div class="text-center">
                        <small>Don't have an account? <a href="/Account/Register">Register here</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }

    private LoginModel loginModel { get; set; } = new() { Role = UserRoleType.Admin };

    private sealed class LoginModel
    {
        public string SchoolId { get; set; } = string.Empty;
        public UserRoleType Role { get; set; } = UserRoleType.Admin;
        public string Password { get; set; } = string.Empty;
    }
}
