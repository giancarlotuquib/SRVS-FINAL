@page "/"
@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using SyllabusRepository.DTOs
@using SRVS.Domain.Enums

@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Log in</PageTitle>

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-journal-bookmark-fill display-4 text-success"></i>
                        <h1 class="h3 mt-3 mb-1 fw-bold" style="font-weight:500;">Syllabus Repository</h1>
                        <p class="text-warning small text-uppercase fw-semibold" style="letter-spacing:0.1em;">ACADEMIC DOCUMENT MANAGEMENT</p>
                    </div>

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            <div>@ErrorMessage</div>
                        </div>
                    }

                    <EditForm FormName="loginForm" method="post" Model="@LoginInput" OnValidSubmit="LoginUser">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label" for="LoginInput.SchoolId">School ID</label>
                            <InputText @bind-Value="LoginInput.SchoolId" id="LoginInput.SchoolId" class="form-control" placeholder="YYYY-XXXXX" autocomplete="username" />
                            <ValidationMessage For="() => LoginInput.SchoolId" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="LoginInput.Role">Sign in as</label>
                            <InputSelect @bind-Value="LoginInput.Role" id="LoginInput.Role" class="form-select">
                                <option value="" disabled>Select role</option>
                                <option value="@UserRoleType.Admin">Admin</option>
                                <option value="@UserRoleType.DepartmentHead">Department Head</option>
                                <option value="@UserRoleType.Educator">Faculty</option>
                                <option value="@UserRoleType.Viewer">Student</option>
                            </InputSelect>
                            <ValidationMessage For="() => LoginInput.Role" class="text-danger" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label d-flex justify-content-between" for="LoginInput.Password">
                                <span>Password</span>
                                <a class="small text-decoration-none" href="/Account/ForgotPassword">Forgot password?</a>
                            </label>
                            <div class="input-group">
                                <InputText type="@(ShowPassword ? "text" : "password")" @bind-Value="LoginInput.Password" id="LoginInput.Password" class="form-control" autocomplete="current-password" placeholder="Password" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="TogglePasswordVisibility">
                                    <i class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </div>
                            <ValidationMessage For="() => LoginInput.Password" class="text-danger" />
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100" disabled="@IsSubmitting">
                            @if (IsSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            Log in
                        </button>
                    </EditForm>

                    <hr class="my-4" />
                    <div class="text-center">
                        <small>Don't have an account? <a href="/Account/Register">Register here</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool IsSubmitting;
    private bool ShowPassword;
    private string? ErrorMessage;

    
// Login model initialized with property initializer
public LoginRequest LoginInput { get; set; } = new();

    private void TogglePasswordVisibility() => ShowPassword = !ShowPassword;

    private async Task LoginUser()
    {
        IsSubmitting = true;
        ErrorMessage = null;
        try
        {
            // Ensure LoginInput is instantiated (handles possible null from form post)
            if (LoginInput == null)
                LoginInput = new();
            // Validate role selection (client‑side)
            if (!Enum.IsDefined(typeof(UserRoleType), LoginInput.Role))
            {
                ErrorMessage = "Please select a role.";
                // Ensure the UI is no longer in submitting state
                IsSubmitting = false;
                return;
            }

            var response = await Http.PostAsJsonAsync("/api/auth/login", LoginInput);
            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/dashboard");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                ErrorMessage = "Invalid School ID or password.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                var err = await response.Content.ReadFromJsonAsync<RoleMismatchResponse>();
                ErrorMessage = $"Your account is registered as {err?.CorrectRole}. Please select the correct role to continue.";
            }
            else
            {
                ErrorMessage = "An unexpected error occurred. Please try again.";
            }
        }
        catch
        {
            ErrorMessage = "Unable to connect to the authentication server.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class RoleMismatchResponse
    {
        public string CorrectRole { get; set; } = string.Empty;
    }
}
