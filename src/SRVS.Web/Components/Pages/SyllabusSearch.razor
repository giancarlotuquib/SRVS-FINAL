@page "/syllabi/search"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SRVS.Application.Abstractions
@using SRVS.Application.Models
@using SRVS.Web.Data

@inject ISyllabusSearchService SearchService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Computer Engineering Syllabus Repository</PageTitle>

<section class="container py-4">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 p-md-5">
            <p class="text-uppercase text-secondary small mb-1">Computer Engineering Repository</p>
            <h1 class="h3 mb-2">Search Computer Engineering syllabi</h1>
            <p class="text-secondary mb-0">Search Computer Engineering course syllabi based on your role and access permissions.</p>
        </div>
    </div>

    <EditForm Model="search" OnValidSubmit="RunSearchAsync" class="row g-3 align-items-end mb-4">
        <DataAnnotationsValidator />
        <div class="col-lg-8">
            <label class="form-label">Search term</label>
            <InputText class="form-control" @bind-Value="search.Term" placeholder="CE course code, title, semester, or instructor" />
        </div>
        <div class="col-lg-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">Search</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ResetAsync">Reset</button>
        </div>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-info">@message</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-secondary small text-uppercase">CE Results</div><div class="display-6 fw-bold">@results.TotalCount</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-secondary small text-uppercase">Visible</div><div class="display-6 fw-bold">@results.Items.Count</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-secondary small text-uppercase">Your Role</div><div class="display-6 fw-bold">@roleLabel</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-secondary small text-uppercase">Program</div><div class="display-6 fw-bold">CE Only</div></div></div></div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Title</th>
                            <th>Term</th>
                            <th>Status</th>
                            <th>Version</th>
                            <th>Access</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in results.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.CourseCode</td>
                                <td>
                                    <div>@item.CourseTitle</div>
                                    <div class="text-secondary small">@item.InstructorName</div>
                                </td>
                                <td>@item.AcademicYear / @item.Semester</td>
                                <td><span class="badge text-bg-light">@item.Status</span></td>
                                <td>V@item.CurrentVersionNumber</td>
                                <td class="text-secondary small">@item.VisibilityLabel</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-primary btn-sm me-2" href="/syllabi/@item.Id">View Details</a>
                                    @if (item.CanDownload)
                                    {
                                        <a class="btn btn-outline-secondary btn-sm" href="/syllabi/@item.Id/download" target="_blank" title="Download Current Version"><i class="bi bi-download"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@code {
    private SearchModel search = new();
    private SyllabusSearchResults results = new([], 0);
    private ApplicationUser? currentUser;
    private string roleLabel = "Viewer";
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(authState.User)
            ?? throw new InvalidOperationException("A signed-in user is required.");

        roleLabel = currentUser.Role.ToString();
        await RunSearchAsync();
    }

    private async Task RunSearchAsync()
    {
        results = await SearchService.SearchAsync(
            new SyllabusSearchRequest(search.Term, null, 100),
            currentUser!.Role,
            currentUser.DepartmentId,
            currentUser.Id);

        message = results.TotalCount == 0
            ? "No Computer Engineering syllabi matched your search terms in your allowed scope."
            : null;
    }

    private async Task ResetAsync()
    {
        search.Term = string.Empty;
        await RunSearchAsync();
    }

    private sealed class SearchModel
    {
        public string Term { get; set; } = string.Empty;
    }
}