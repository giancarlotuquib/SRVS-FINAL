@page "/dashboard"
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<section class="container py-4">
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <p class="text-uppercase text-secondary small mb-1">Dashboard entry</p>
            <h1 class="h3 mb-2">Choose the workspace for your role</h1>
            <p class="text-secondary mb-0">Login redirects you directly to the correct workspace. This page stays as a fallback landing area.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3"><a class="card card-body text-decoration-none" href="/admin/dashboard"><strong>Admin</strong><span class="text-secondary small d-block"></span></a></div>
        <div class="col-md-3"><a class="card card-body text-decoration-none" href="/department-head/dashboard"><strong>Department Head</strong><span class="text-secondary small d-block"></span></a></div>
        <div class="col-md-3"><a class="card card-body text-decoration-none" href="/educator/dashboard"><strong>Faculty</strong><span class="text-secondary small d-block"></span></a></div>
        <div class="col-md-3"><a class="card card-body text-decoration-none" href="/viewer/dashboard"><strong>Student</strong><span class="text-secondary small d-block"></span></a></div>
    </div>
</section>