@page "/admin/user-management"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using SRVS.Domain.Entities
@using SRVS.Domain.Enums
@using SRVS.Web.Data

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>User Management</PageTitle>

<section class="container py-4">
    <h1 class="h3 mb-4">User Management</h1>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (users.Count == 0)
    {
        <p>No users found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Institutional ID</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td class="fw-semibold">@user.UserName</td>
                            <td>@user.InstitutionalId</td>
                            <td>@user.Role</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(user.AccountStatus)">@user.AccountStatus</span>
                            </td>
                            <td class="text-nowrap">
                                <div class="dropdown @(openActionsUserId == user.Id ? "show" : "")">
                                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" @onclick="() => ToggleActionsMenu(user.Id)" aria-expanded="@(openActionsUserId == user.Id)" disabled="@isProcessing">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end @(openActionsUserId == user.Id ? "show" : "")">
                                        <li>
                                            <button class="dropdown-item" type="button" @onclick="() => OpenStatusConfirmation(user, UserAccountStatus.Active)" disabled="@IsActionDisabled(user, UserAccountStatus.Active)">
                                                Activate
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" type="button" @onclick="() => OpenStatusConfirmation(user, UserAccountStatus.Suspended)" disabled="@IsActionDisabled(user, UserAccountStatus.Suspended)">
                                                Deactivate
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <button class="dropdown-item text-danger" type="button" @onclick="() => OpenDeleteConfirmation(user)" disabled="@IsActionDisabled(user, UserAccountStatus.Deleted)">
                                                Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (showConfirmModal && pendingUser is not null)
    {
        <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@confirmTitle</h5>
                        <button type="button" class="btn-close" @onclick="CloseConfirmation"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">@confirmMessage</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseConfirmation" disabled="@isProcessing">Cancel</button>
                        <button class="btn @confirmButtonClass" @onclick="ApplyConfirmedActionAsync" disabled="@isProcessing">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private List<ApplicationUser> users = [];
    private bool isProcessing;
    private bool showConfirmModal;
    private ApplicationUser? pendingUser;
    private UserAccountStatus? pendingStatus;
    private string? openActionsUserId;
    private string successMessage = string.Empty;
    private string confirmTitle = string.Empty;
    private string confirmMessage = string.Empty;
    private string confirmButtonClass = "btn-primary";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var currentUser = authState.User;

        if (currentUser.Identity?.IsAuthenticated != true || !currentUser.IsInRole("Admin"))
        {
            return;
        }

        await using var dbContext = await DbFactory.CreateDbContextAsync();
        users = await dbContext.Users
            .AsNoTracking()
            .OrderBy(user => user.UserName)
            .ToListAsync();
    }

    private static bool IsActionDisabled(ApplicationUser user, UserAccountStatus targetStatus)
    {
        return user.AccountStatus == targetStatus;
    }

    private void ToggleActionsMenu(string userId)
    {
        openActionsUserId = openActionsUserId == userId ? null : userId;
    }

    private void OpenStatusConfirmation(ApplicationUser user, UserAccountStatus newStatus)
    {
        if (IsActionDisabled(user, newStatus) || isProcessing)
        {
            return;
        }

        pendingUser = user;
        pendingStatus = newStatus;
        showConfirmModal = true;
        openActionsUserId = null;
        confirmButtonClass = newStatus == UserAccountStatus.Active ? "btn-success" : "btn-warning";
        confirmTitle = newStatus == UserAccountStatus.Active ? "Activate User" : "Deactivate User";
        confirmMessage = newStatus == UserAccountStatus.Active
            ? $"Activate user '{user.UserName}'? They will be able to sign in again."
            : $"Deactivate user '{user.UserName}'? They will not be able to sign in.";
    }

    private void OpenDeleteConfirmation(ApplicationUser user)
    {
        if (IsActionDisabled(user, UserAccountStatus.Deleted) || isProcessing)
        {
            return;
        }

        pendingUser = user;
        pendingStatus = UserAccountStatus.Deleted;
        showConfirmModal = true;
    openActionsUserId = null;
        confirmButtonClass = "btn-danger";
        confirmTitle = "Delete User";
        confirmMessage = $"Soft-delete user '{user.UserName}'? This sets status to Deleted for audit trail.";
    }

    private void CloseConfirmation()
    {
        showConfirmModal = false;
        pendingUser = null;
        pendingStatus = null;
    }

    private async Task ApplyConfirmedActionAsync()
    {
        if (pendingUser is null || pendingStatus is null || isProcessing)
        {
            return;
        }

        isProcessing = true;

        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            var dbUser = await dbContext.Users.FirstOrDefaultAsync(item => item.Id == pendingUser.Id);

            if (dbUser is null)
            {
                CloseConfirmation();
                return;
            }

            dbUser.AccountStatus = pendingStatus.Value;
            await dbContext.SaveChangesAsync();

            users = await dbContext.Users
                .AsNoTracking()
                .OrderBy(item => item.UserName)
                .ToListAsync();

            successMessage = pendingStatus == UserAccountStatus.Deleted
                ? $"User '{pendingUser.UserName}' was deleted and saved to the database."
                : pendingStatus == UserAccountStatus.Active
                    ? $"User '{pendingUser.UserName}' was activated and saved to the database."
                    : $"User '{pendingUser.UserName}' was deactivated and saved to the database.";

            CloseConfirmation();
        }
        finally
        {
            isProcessing = false;
        }
    }

    private static string GetStatusBadgeClass(UserAccountStatus status) => status switch
    {
        UserAccountStatus.Active => "text-bg-success",
        UserAccountStatus.PendingApproval => "text-bg-warning text-dark",
        UserAccountStatus.Suspended => "text-bg-secondary",
        UserAccountStatus.Rejected => "text-bg-danger",
        UserAccountStatus.Deleted => "text-bg-dark",
        _ => "text-bg-secondary"
    };
}
